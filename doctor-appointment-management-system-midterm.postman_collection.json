{
  "info": {
    "name": "Doctor Appointment Management System - Midterm",
    "description": "INSY 8322 mid-term - Shema Christian (26991). One request per requirement, named by its ID, plus failing cases (404, 400, 409). The id variables point at the seed data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 0 - seed data",
      "description": "The seed data was entered once through these save endpoints (all returned 201). They are kept as a record of how it was done; running them again creates duplicates and changes the expected results of B, C and the dashboard. Consultations dated before today can no longer be saved, because of D1.",
      "item": [
        {
          "name": "Seed - save medical field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/medical-fields/save",
            "description": "Saved four times: Cardiology, Pediatrics, Dermatology, Orthopedics.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cardiology\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Seed - save consulting room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consulting-rooms/save",
            "description": "Saved for rooms 201, 202, 203 and 204.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": 201,\n  \"name\": \"Consulting Room 201\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Seed - save physician",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/physicians/save",
            "description": "Room and medical fields are sent by id. Jean Mugisha holds Cardiology and Pediatrics.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Mugisha\",\n  \"licenceNumber\": \"RMDC-1001\",\n  \"consultingRoom\": {\n    \"id\": \"{{consultingRoomId}}\"\n  },\n  \"medicalFields\": [\n    {\n      \"id\": \"{{medicalFieldId}}\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Seed - save outpatient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/outpatients/save",
            "description": "Five outpatients; Grace and Diane share the lastName Uwase.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Grace\",\n  \"lastName\": \"Uwase\",\n  \"nationalId\": \"1199880012345678\",\n  \"phone\": \"0788123456\",\n  \"email\": \"grace.uwase@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Seed - save consultation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/save",
            "description": "Ten consultations over October and November 2026, entered before D1 existed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-11-12\",\n  \"complaint\": \"Cardiology check-up\",\n  \"outpatient\": {\n    \"id\": \"{{outpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{physicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Part A - domain model and CRUD",
      "description": "A1 entities and relationships, A2 CRUD for the five entities.",
      "item": [
        {
          "name": "A1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/physicians/all",
            "description": "A1: a physician shows its consulting room and medical fields. The medical fields do not list their physicians (@JsonIgnore on MedicalField.physicians), so the JSON does not loop."
          },
          "response": []
        },
        {
          "name": "A1 - medical fields do not show physicians",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medical-fields/all",
            "description": "A1: only id and name; no physicians list."
          },
          "response": []
        },
        {
          "name": "A2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/save",
            "description": "A2: 201 \"Consultation saved successfully\". The test script below is not needed for the demo; \"A2 - delete\" removes this consultation again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-12-10\",\n  \"complaint\": \"Postman A2 test\",\n  \"outpatient\": {\n    \"id\": \"{{otherOutpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{otherPhysicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "A2 - get all",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/all",
            "description": "A2: 200 with every consultation. The test script stores the id of the consultation made by \"A2\" in the variable newConsultationId, for \"A2 - delete\"."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const made = pm.response.json().find(c => c.complaint === 'Postman A2 test');",
                  "if (made) { pm.collectionVariables.set('newConsultationId', made.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{bookedConsultationId}}",
            "description": "A2: 200 with the consultation."
          },
          "response": []
        },
        {
          "name": "A2 - get by id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/00000000-0000-0000-0000-000000000000",
            "description": "A2: 404 \"The consultation with that id does not exist\"."
          },
          "response": []
        },
        {
          "name": "A2 - update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/update/{{bookedConsultationId}}",
            "description": "A2: 200 \"Consultation updated successfully\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-11-12\",\n  \"complaint\": \"Cardiology check-up\",\n  \"outpatient\": {\n    \"id\": \"{{outpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{physicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "A2 - update (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/update/00000000-0000-0000-0000-000000000000",
            "description": "A2: 404 \"The consultation with that id does not exist\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-11-12\",\n  \"complaint\": \"x\",\n  \"outpatient\": {\n    \"id\": \"{{outpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{physicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "A2 - delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/consultations/delete/{{newConsultationId}}",
            "description": "A2: 200 \"Consultation deleted successfully\". Run \"A2\" and \"A2 - get all\" first."
          },
          "response": []
        },
        {
          "name": "A2 - delete (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/consultations/delete/00000000-0000-0000-0000-000000000000",
            "description": "A2: 404 \"The consultation with that id does not exist\"."
          },
          "response": []
        },
        {
          "name": "A2 - medical fields get by id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medical-fields/00000000-0000-0000-0000-000000000000",
            "description": "A2 pattern on another entity: 404 \"The medical field with that id does not exist\"."
          },
          "response": []
        },
        {
          "name": "A2 - consulting rooms get all",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consulting-rooms/all",
            "description": "A2: 200 with the four rooms."
          },
          "response": []
        },
        {
          "name": "A2 - outpatients get by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/{{outpatientId}}",
            "description": "A2: 200 with Grace Uwase."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Part B - derived queries",
      "description": "B1 to B3, all solved by method name only (no @Query).",
      "item": [
        {
          "name": "B1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/by-last-name?lastName=uwase",
            "description": "B1: findByLastNameIgnoreCaseOrderByFirstNameAsc. Diane Uwase then Grace Uwase (firstName A to Z)."
          },
          "response": []
        },
        {
          "name": "B1 - other letter case",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/by-last-name?lastName=UWASE",
            "description": "B1: same two outpatients; letter case does not matter."
          },
          "response": []
        },
        {
          "name": "B1 - nobody matches",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/by-last-name?lastName=nobody",
            "description": "B1: 200 with an empty list []."
          },
          "response": []
        },
        {
          "name": "B2",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/by-status?status=BOOKED",
            "description": "B2: findByStatusOrderByConsultDateAsc. The BOOKED consultations, earliest consultDate first."
          },
          "response": []
        },
        {
          "name": "B2 - ATTENDED",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/by-status?status=ATTENDED",
            "description": "B2: the three ATTENDED consultations, earliest first."
          },
          "response": []
        },
        {
          "name": "B2 - not a status (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/by-status?status=DONE",
            "description": "B2: the parameter is the ConsultationStatus enum, so an unknown value is rejected by Spring with 400."
          },
          "response": []
        },
        {
          "name": "B3",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/between?start=2026-10-01&end=2026-10-31",
            "description": "B3: findByConsultDateBetweenOrderByConsultDateAsc. The six October consultations in date order; the controller parses the Strings with LocalDate.parse."
          },
          "response": []
        },
        {
          "name": "B3 - one day, both ends included",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/between?start=2026-10-20&end=2026-10-20",
            "description": "B3: both consultations of 2026-10-20, which shows Between includes both dates."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Part C - JPQL with joins",
      "description": "C1 to C4, all written with @Query.",
      "item": [
        {
          "name": "C1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/physicians/by-medical-field?name=cardiology",
            "description": "C1: JOIN p.medicalFields m WHERE LOWER(m.name) = LOWER(:name). Returns Jean Mugisha."
          },
          "response": []
        },
        {
          "name": "C1 - other letter case",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/physicians/by-medical-field?name=PEDIATRICS",
            "description": "C1: Mugisha and Habimana; letter case does not matter."
          },
          "response": []
        },
        {
          "name": "C1 - field nobody holds",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/physicians/by-medical-field?name=orthopedics",
            "description": "C1: 200 with an empty list []."
          },
          "response": []
        },
        {
          "name": "C2",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consulting-rooms/free",
            "description": "C2: NOT EXISTS subquery, sorted by roomNumber. With the seed data: room 204 only."
          },
          "response": []
        },
        {
          "name": "C3",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medical-fields/unused",
            "description": "C3: m.physicians IS EMPTY (no counting). With the seed data: Orthopedics only."
          },
          "response": []
        },
        {
          "name": "C4",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/of-physician/{{physicianId}}",
            "description": "C4: SELECT DISTINCT c.outpatient ... WHERE c.physician.id = :physicianId. Mugisha's outpatients; Grace has two consultations with him but is listed once."
          },
          "response": []
        },
        {
          "name": "C4 - physician does not exist (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/outpatients/of-physician/00000000-0000-0000-0000-000000000000",
            "description": "C4: 404 \"The physician with that id does not exist\"."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Part D - business rules",
      "description": "Run top to bottom: D1 creates a test consultation that D2 then moves through its statuses and finally deletes; D3 and D4 end with a request that puts the seed data back, so the folder can be run again.",
      "item": [
        {
          "name": "D1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/save",
            "description": "D1: 201 \"Consultation saved successfully\". The body says ATTENDED, but a new consultation always starts as BOOKED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-12-15\",\n  \"status\": \"ATTENDED\",\n  \"complaint\": \"Postman D1 test\",\n  \"outpatient\": {\n    \"id\": \"{{otherOutpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{otherPhysicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "D1 - date in the past (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/save",
            "description": "D1: consultDate.isBefore(LocalDate.now()) -> 400 \"Consultation date cannot be in the past\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-10-20\",\n  \"complaint\": \"past\",\n  \"outpatient\": {\n    \"id\": \"{{otherOutpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{physicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "D1 - physician already booked (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/save",
            "description": "D1: existsByPhysicianAndConsultDateAndStatusNot(..., CANCELLED). Mugisha already has a BOOKED consultation on 2026-11-05 -> 409 \"Physician is already booked on that date\".",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-11-05\",\n  \"complaint\": \"double booking\",\n  \"outpatient\": {\n    \"id\": \"{{otherOutpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{physicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "D1 - check it was saved as BOOKED",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/by-status?status=BOOKED",
            "description": "D1: the test consultation is in the BOOKED list. The test script stores its id in newConsultationId for D2."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const made = pm.response.json().find(c => c.complaint === 'Postman D1 test');",
                  "if (made) { pm.collectionVariables.set('newConsultationId', made.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "D2",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{newConsultationId}}/status?status=CHECKED_IN",
            "description": "D2: BOOKED -> CHECKED_IN is allowed: 200 \"Consultation status updated successfully\"."
          },
          "response": []
        },
        {
          "name": "D2 - going back (400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{newConsultationId}}/status?status=BOOKED",
            "description": "D2: 400 \"Cannot change status from CHECKED_IN to BOOKED\"."
          },
          "response": []
        },
        {
          "name": "D2 - CHECKED_IN to ATTENDED",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{newConsultationId}}/status?status=ATTENDED",
            "description": "D2: allowed: 200."
          },
          "response": []
        },
        {
          "name": "D2 - final status (400)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{newConsultationId}}/status?status=BOOKED",
            "description": "D2: ATTENDED is final: 400 \"Cannot change status from ATTENDED to BOOKED\"."
          },
          "response": []
        },
        {
          "name": "D2 - consultation does not exist (404)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/consultations/00000000-0000-0000-0000-000000000000/status?status=CHECKED_IN",
            "description": "D2: 404 \"The consultation with that id does not exist\"."
          },
          "response": []
        },
        {
          "name": "D2 - PUT update does not change the status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/consultations/update/{{newConsultationId}}",
            "description": "D2: the body says CANCELLED; the update returns 200 but the status stays ATTENDED (see the next request). Status only changes through PATCH /{id}/status.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultDate\": \"2026-12-15\",\n  \"status\": \"CANCELLED\",\n  \"complaint\": \"Postman D1 test\",\n  \"outpatient\": {\n    \"id\": \"{{otherOutpatientId}}\"\n  },\n  \"physician\": {\n    \"id\": \"{{otherPhysicianId}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "D2 - check the status is still ATTENDED",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/consultations/{{newConsultationId}}",
            "description": "D2: status is ATTENDED."
          },
          "response": []
        },
        {
          "name": "D2 - clean up the test consultation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/consultations/delete/{{newConsultationId}}",
            "description": "Removes the consultation made by D1: 200 \"Consultation deleted successfully\"."
          },
          "response": []
        },
        {
          "name": "D3",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/physicians/{{otherPhysicianId}}/medical-fields/{{medicalFieldId}}",
            "description": "D3: adds Cardiology to Eric Habimana and keeps Pediatrics: 200 \"Medical field added to the physician\"."
          },
          "response": []
        },
        {
          "name": "D3 - already has it (409)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/physicians/{{otherPhysicianId}}/medical-fields/{{medicalFieldId}}",
            "description": "D3: 409 \"The physician already has that medical field\"."
          },
          "response": []
        },
        {
          "name": "D3 - physician does not exist (404)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/physicians/00000000-0000-0000-0000-000000000000/medical-fields/{{medicalFieldId}}",
            "description": "D3: 404 \"The physician with that id does not exist\"."
          },
          "response": []
        },
        {
          "name": "D3 - medical field does not exist (404)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/physicians/{{otherPhysicianId}}/medical-fields/00000000-0000-0000-0000-000000000000",
            "description": "D3: 404 \"That medical field does not exist\"."
          },
          "response": []
        },
        {
          "name": "D3 - restore Habimana to Pediatrics only",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/physicians/update/{{otherPhysicianId}}",
            "description": "Puts the seed data back (Habimana holds exactly one medical field).",
